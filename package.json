{
  "name": "prism",
  "version": "0.1.0-alpha.7",
  "description": "Prism - Private media download, conversion, and transcription suite",
  "main": "./out/main/index.js",
  "author": "clivingston33",
  "license": "MIT",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format:check": "prettier --check .",
    "verify:resources": "node scripts/verify-resources.mjs",
    "prepare:resources:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/prepare-windows.ps1",
    "test": "node --no-warnings --experimental-strip-types --test \"test/*.test.ts\"",
    "test:watch": "node --no-warnings --experimental-strip-types --test --watch \"test/*.test.ts\"",
    "test:e2e:native": "node scripts/e2e/native-media.mjs",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node -e \"if (!process.env.ELECTRON_SKIP_BINARY_DOWNLOAD) require('electron')\" && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run verify:resources && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/geist-mono": "^5.0.0",
    "@fontsource/geist-sans": "^5.0.0",
    "@tanstack/react-router": "^1.170.32",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.14.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.7",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tmp": "0.2.7"
  }
}
